# Server Configuration
NODE_ENV=development
PORT=3000              # Backend API port
WORKER_PORT=3001        # Worker HTTP server port (optional)
HOST=localhost

# Frontend Configuration
FRONTEND_PORT=5173     # Frontend Vite port
FRONTEND_URL=http://localhost:5173

# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/burhan2ws?schema=public"

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# WhatsApp Configuration
WA_SESSION_DIR=.wa-sessions
WA_RECONNECT_INTERVAL=30000

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# Webhook Secret
WEBHOOK_SECRET=burhan2ws-webhook-secret-change-this-in-production

# JWT Secret (for future authentication)
JWT_SECRET=burhan2ws_jwt_secret_change_in_production

# WebSocket Configuration
WS_CORS_ORIGIN=http://localhost:5173
