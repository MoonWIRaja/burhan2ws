# Database
DB_PROVIDER="postgresql"
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# Supabase notes:
# - Use the Transaction Pooler / connection string from Supabase
# - Keep DB_PROVIDER="postgresql"
# - Replace [project-ref], [password], and [region] with your Supabase values

# MySQL example
# DB_PROVIDER="mysql"
# DATABASE_URL="mysql://root:password@localhost:3306/whatsapp_blast"

# Authentication
BETTER_AUTH_SECRET="change-this-to-a-random-secret-key"

# Data Storage (local filesystem)
DATA_PATH="./data"

# Server
PORT=3001
FRONTEND_URL="http://localhost:3000"

# Frontend API URL (client-side, exposed to browser)
# Used by Next.js frontend for API requests and Socket.io connection
# Examples:
# - Local: NEXT_PUBLIC_API_URL="http://localhost:3001"
# - Dev: NEXT_PUBLIC_API_URL="https://api-dev.owlscottage.com"
# - Production: NEXT_PUBLIC_API_URL="https://api.owlscottage.com"
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Backend API URL (server-side, for Next.js API routes)
# Used internally by Next.js API routes to forward requests to backend
API_URL="http://localhost:3001"
