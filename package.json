{
  "name": "burhan2ws",
  "version": "1.0.0",
  "description": "WhatsApp Web Gateway with ISO Matrix 3D Theme",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "concurrently \"nodemon src/server.js\" \"node src/workers/index.js\" \"cd frontend && npm run dev\" --names backend,worker,frontend --prefix-colors cyan,magenta,green",
    "dev:backend": "nodemon src/server.js",
    "dev:worker": "node src/workers/index.js",
    "dev:frontend": "cd frontend && npm run dev",
    "worker": "node src/workers/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "keywords": [
    "whatsapp",
    "gateway",
    "baileys",
    "socket.io",
    "bullmq"
  ],
  "author": "MoonWiraja",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.8.0",
    "@whiskeysockets/baileys": "^6.6.0",
    "bullmq": "^5.1.8",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "ioredis": "^5.3.2",
    "multer": "^1.4.5-lts.1",
    "node-cache": "^5.1.2",
    "pdf-parse": "^1.1.1",
    "pino": "^8.17.2",
    "prisma": "^5.8.0",
    "qrcode-terminal": "^0.12.0",
    "socket.io": "^4.7.2",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2"
  }
}
